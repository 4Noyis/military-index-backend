            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Republic of Turkey\",\n  \"code\": \"TUR\",\n  \"flag_url\": \"/flags/turkey.svg\"\n}"
            },
            "url": {
