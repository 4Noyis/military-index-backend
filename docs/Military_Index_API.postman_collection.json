    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get API Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Check the health status of the API Gateway"
          },
          "response": []
        }
      ]
    },
    {
      "name": "Countries",
      "item": [
        {
          "name": "Get All Countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/countries?page=1&limit=10",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "countries"],
              "query": [
                {
                  "key": "page",
                  "value": "1",
                  "description": "Page number"
                },
                {
                  "key": "limit",
                  "value": "10",
                  "description": "Items per page"
                }
              ]
            },
            "description": "Retrieve a paginated list of all countries"
          },
          "response": []
        },
        {
          "name": "Get Country by ID",
          "request": {
            "method": "GET",
            "header": [],
