            "description": "Retrieve a country by its ISO country code"
          },
          "response": []
        },
        {
          "name": "Search Countries",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/v1/countries?q=Turkey",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "countries"],
              "query": [
                {
                  "key": "q",
                  "value": "Turkey",
                  "description": "Search query"
                }
              ]
            },
            "description": "Search countries by name or code"
