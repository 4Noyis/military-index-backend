# Application Environment
NODE_ENV=development
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=militaryindex
DB_PASSWORD=change_this_password
DB_NAME=military_index_db
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=3600

# Full Database URL (12 Factor: Single source of truth)
DATABASE_URL=postgresql://username:password@localhost:5432/military_index_db

# pgAdmin (Development only)
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Service Ports
INDEX_SERVICE_PORT=8081
COUNTRY_SERVICE_PORT=8082
API_GATEWAY_PORT=8080
