# Application Environment
NODE_ENV=development
APP_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=militaryindex
DB_PASSWORD=your_secure_password_here
DB_NAME=military_index_db
DB_SSLMODE=disable
DB_MAX_CONNECTIONS=100
DB_MAX_IDLE_CONNECTIONS=10
DB_CONNECTION_MAX_LIFETIME=3600

# Full Database URL (12 Factor: Single source of truth)
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?sslmode=${DB_SSLMODE}

# pgAdmin (Development only)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=your_pgadmin_password_here
PGADMIN_PORT=5050

# Logging
LOG_LEVEL=debug
LOG_FORMAT=json

# Service Ports
TECHNOLOGY_SERVICE_PORT=8081
COUNTRY_SERVICE_PORT=8082
API_GATEWAY_PORT=8080

# API Gateway Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=60
TECHNOLOGY_SERVICE_URL=http://technology-service:8081
COUNTRY_SERVICE_URL=http://country-service:8082
